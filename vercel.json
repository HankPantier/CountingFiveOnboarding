{
  "crons": [
    {
      "path": "/api/cron/check-inactivity",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/sweep-stuck-jobs",
      "schedule": "*/5 * * * *"
    }
  ],
  "functions": {
    "app/api/content-jobs/[id]/generate/route.ts": { "maxDuration": 300 },
    "app/api/content-jobs/[id]/package/route.ts": { "maxDuration": 120 },
    "app/api/content-jobs/[id]/seed-repo/route.ts": { "maxDuration": 300 },
    "app/api/content-jobs/[id]/outlines/generate/route.ts": { "maxDuration": 120 },
    "app/api/audits/[id]/run/route.ts": { "maxDuration": 300 },
    "app/api/audits/[id]/draft-session/route.ts": { "maxDuration": 120 }
  }
}
