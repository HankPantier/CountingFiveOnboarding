# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# claude code local settings
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase CLI cache (per-machine state, never wanted in git)
supabase/.temp/

# Local-only reference artifacts: dropped-in PDFs and screenshot working
# directory used as scratch input for design/UI iteration. Track in the
# project root only if a PDF is intended as a deliverable.
/*.pdf
raw-docs/screenshots/

# Local-only one-off report generator script + its scratch preview output
# (not part of the app)
/build_revaltus_report.py
/_prev_*.png

# Brainstorm visual-companion artifacts
.superpowers/
